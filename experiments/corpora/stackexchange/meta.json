  "seconds": 379.9,
  "embedding": {
    "model": "sentence-transformers/all-MiniLM-L6-v2",
    "dim": 384,
    "normalized": true,
    "dtype": "float32",
    "seconds": 846.6,
    "device": "cuda"
  }
}